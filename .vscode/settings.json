{
  // Pasted or dragged-in images go to ./attachments/ beside the note
  "markdown.copyFiles.destination": {
    "**/*.md": "attachments/${documentBaseName}-${fileName}"
  },
  "markdown.copyFiles.overwriteBehavior": "nameIncrementally",

  // Keep links working when notes are moved or renamed
  "markdown.updateLinksOnFileMove.enabled": "always",

  // Warn about broken links inside notes
  "markdown.validate.enabled": true,

  // markdownlint: allow long lines, and the HTML used in notes (collapsible sections, key caps, spacing, sized images)
  "markdownlint.config": {
    "MD013": false,
    "MD033": {
      "allowed_elements": ["details", "summary", "strong", "kbd", "br", "img"]
    }
  },

  // Tidy files
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",
  "[markdown]": {
    "editor.wordWrap": "on"
  }
}
